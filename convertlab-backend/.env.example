# Application Configuration
SPRING_APPLICATION_NAME=convertlab-backend

# Server Configuration
SERVER_PORT=8080
SERVER_CONTEXT_PATH=/api

# File Upload Configuration
MAX_FILE_SIZE=75MB
MAX_REQUEST_SIZE=90MB
MAX_SWALLOW_SIZE=200MB

# Upload Validation Limits
VALIDATION_PDF_MAX_SIZE_MB=25
VALIDATION_PDF_AUTHENTICATED_MAX_SIZE_MB=75
VALIDATION_IMAGE_MAX_SIZE_MB=10
VALIDATION_IMAGE_AUTHENTICATED_MAX_SIZE_MB=50

# Temporary File Storage Configuration
TEMP_FOLDER=temp-files
TEMP_TTL_MS=1800000
TEMP_CLEANUP_INTERVAL_MS=1800000

# CORS Configuration (comma-separated list of allowed origins)
CORS_ALLOWED_ORIGINS=https://www.easyconvertlab.com,http://localhost:4200

# Security Configuration (comma-separated root user emails)
SUPER_ADMIN_EMAILS=

# Logging Configuration (Optional)
LOG_LEVEL_ROOT=info
LOG_LEVEL_APP=info
LOG_LEVEL_SPRING=info
LOG_LEVEL_PDFBOX=warn
